# Both agents route their LLM calls through LiteLlm using OpenAI models
# (e.g. "openai/gpt-4o", "gpt-image-1", "gpt-4o-mini-tts"), so an OpenAI key
# is required to run them as published.
OPENAI_API_KEY=

# Google ADK / Gemini. Set these if you switch the agents to Gemini models.
# GOOGLE_API_KEY and GEMINI_API_KEY are interchangeable for google-genai.
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Financial advisor news_analyst web search (Firecrawl)
FIRECRAWL_API_KEY=
