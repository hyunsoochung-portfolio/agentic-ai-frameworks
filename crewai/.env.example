# Copy this file to .env and fill in your own keys.

# Used by all three projects (CrewAI uses OpenAI models by default).
OPENAI_API_KEY=

# news-reader-agent: Serper powers SerperDevTool web search.
SERPER_API_KEY=

# job-hunter-agent & content-pipeline-agent: Firecrawl powers web search/scrape.
FIRECRAWL_API_KEY=
